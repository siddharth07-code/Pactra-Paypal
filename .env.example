GEMINI_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# -----------------------------------------------------------------------------
# Rate Limiting & Proxy Security Configuration
# -----------------------------------------------------------------------------
# Storage backend: "memory" (default for single-instance / local dev) or "redis" (distributed production)
RATE_LIMIT_BACKEND=memory
# Redis connection URL (required if RATE_LIMIT_BACKEND=redis)
# Example: redis://default:password@localhost:6379 or rediss://...
REDIS_URL=
# Distributed fail-closed mode: When true (or in production), rejects requests with 429 if Redis is unreachable
RATE_LIMIT_FAIL_CLOSED=false
# Explicit proxy trust: Set to "true" ONLY when deployed behind a trusted reverse proxy (e.g. ALB, Cloudflare, Nginx)
# Setting this to false prevents clients from spoofing client IP via x-forwarded-for headers.
TRUST_PROXY=false
# Internal Gateway Shared Secret: Authorizes upstream API gateways to set authenticated user identity headers
# (x-pactum-user-id / x-authenticated-user). Untrusted client requests without this secret cannot spoof identity.
INTERNAL_GATEWAY_SECRET=

# -----------------------------------------------------------------------------
# Gemini Quota Protection & Circuit Breaker
# -----------------------------------------------------------------------------
# Maximum Gemini request starts per minute across the application.
# IMPORTANT: Google Gemini Free Tier is restricted to 5-15 RPM depending on model.
# Set this to match your GCP project quota tier (Free tier: 5-15, Pay-as-you-go: 60-1000+)
GEMINI_MAX_REQUESTS_PER_MINUTE=15
# Maximum concurrent active Gemini API calls (Default: 2)
GEMINI_MAX_CONCURRENT_REQUESTS=2
# Maximum attempts per logical operation before immediate deterministic fallback (Default: 2)
GEMINI_MAX_ATTEMPTS=2
# Upstream Gemini HTTP timeout in milliseconds (Default: 12000)
GEMINI_PROVIDER_TIMEOUT_MS=12000
# Consecutive 5xx/429 failures before opening provider circuit breaker (Default: 3)
GEMINI_CIRCUIT_BREAKER_THRESHOLD=3
# Cooldown duration in milliseconds when circuit breaker is OPEN before testing HALF_OPEN probe (Default: 30000)
GEMINI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# -----------------------------------------------------------------------------
# Authenticated Cron Maintenance & Session Retention
# -----------------------------------------------------------------------------
# Shared secret for authenticating POST /api/cron/health and POST /api/cron/cleanup.
# Required in production. Passed via Authorization: Bearer <secret> or x-cron-secret header.
CRON_SECRET=
# Session retention horizon in days for safe cleanup (Default: 30 days).
# Sessions with active negotiations, agreements, pending captures, or disputes are strictly preserved.
SESSION_RETENTION_DAYS=30


