GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-mediated Supabase Auth. No service-role/secret key is used by this foundation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Canonical origin: HTTPS in production; http://localhost:3000 for local development.
APP_ORIGIN=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# -----------------------------------------------------------------------------
# Rate Limiting & Proxy Security Configuration
# -----------------------------------------------------------------------------
# Storage backend: "memory" (default for single-instance / local dev) or "redis" (distributed production)
RATE_LIMIT_BACKEND=memory
# Redis connection URL (required if RATE_LIMIT_BACKEND=redis)
# Example: redis://default:password@localhost:6379 or rediss://...
REDIS_URL=
# Distributed fail-closed mode: When true (or in production), rejects requests with 429 if Redis is unreachable
RATE_LIMIT_FAIL_CLOSED=false
# Explicit proxy trust: Set to "true" ONLY when deployed behind a trusted reverse proxy (e.g. ALB, Cloudflare, Nginx)
# Setting this to false prevents clients from spoofing client IP via x-forwarded-for headers.
TRUST_PROXY=false
# Internal Gateway Shared Secret: Authorizes upstream API gateways to set authenticated user identity headers
# (x-pactum-user-id / x-authenticated-user). Untrusted client requests without this secret cannot spoof identity.
INTERNAL_GATEWAY_SECRET=

# -----------------------------------------------------------------------------
# Gemini Quota Protection & Circuit Breaker
# -----------------------------------------------------------------------------
# Maximum Gemini request starts per minute across the application.
# Match the quota shown for your configured model and Google project.
GEMINI_MAX_REQUESTS_PER_MINUTE=15
# Maximum concurrent active Gemini API calls (Default: 2)
GEMINI_MAX_CONCURRENT_REQUESTS=2
# Maximum attempts per logical operation before immediate deterministic fallback (Default: 2)
GEMINI_MAX_ATTEMPTS=2
# Upstream Gemini HTTP timeout in milliseconds (Default: 12000)
GEMINI_PROVIDER_TIMEOUT_MS=12000
# Consecutive 5xx/429 failures before opening provider circuit breaker (Default: 3)
GEMINI_CIRCUIT_BREAKER_THRESHOLD=3
# Cooldown duration in milliseconds when circuit breaker is OPEN before testing HALF_OPEN probe (Default: 30000)
GEMINI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# -----------------------------------------------------------------------------
# Authenticated Cron Maintenance & Session Retention
# -----------------------------------------------------------------------------
# Shared secret for GET /api/cron/reconcile (Vercel Cron), health, and cleanup.
# Required in production. Passed via Authorization: Bearer <secret> or x-cron-secret header.
CRON_SECRET=
# Session retention horizon in days for safe cleanup (Default: 30 days).
# PostgreSQL retention cleanup is disabled; this setting only governs the legacy coordinator.
SESSION_RETENTION_DAYS=30



# -----------------------------------------------------------------------------
# FX Reference Rates (server-side only; PayPal Sandbox)
# -----------------------------------------------------------------------------
# Default remains offline demo. Set LIVE_PROVIDER explicitly to use ExchangeRate-API.
# Explicit live selection never silently substitutes a demo rate.
FX_PROVIDER=DETERMINISTIC_DEMO
# Authenticated pair endpoint: https://www.exchangerate-api.com/docs/pair-conversion-requests
EXCHANGE_RATE_API_KEY=
# PACTUM quote lifetime: 1-900 seconds. Existing 15-minute default is preserved; use 300 for five minutes.
FX_QUOTE_TTL_SECONDS=900
# Provider data maximum age: 1-90000 seconds; default 25h accommodates daily free-tier publication.
# Also reject rates more than 1h beyond provider time_next_update_unix.
# Reference freshness is independent of PACTUM quote lifetime.
FX_REFERENCE_MAX_AGE_SECONDS=90000
# Free authenticated plan: daily reference updates, 1500 requests/month. No guaranteed executable rate.

# Private Prisma runtime and worker logins (never schema-owner/service-role credentials).
# Provision capability grants using the database runbook before deployment.
EXPECTED_SUPABASE_PROJECT_REF=telhivuqsrsaesjkkxuh
DATABASE_URL=
WORKER_DATABASE_URL=
# Migration tooling only. Do not inject into the application deployment.
DIRECT_URL=
# Explicit offline import tool only; never set PACTUM_LEGACY_IMPORT_APPROVED routinely.
MIGRATION_DATABASE_URL=
# PayPal Sandbox merchant identity is required in database mode.
PAYPAL_MERCHANT_ID=
# Routine tests remain offline. Explicitly set only for separately approved live diagnostics.
PACTUM_LIVE_TESTS=0
